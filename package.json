{
	"name": "TOC compatible with Publish",
	"version": "3.3.1",
	"description": "Supports an automatically updatable table of contents. This table will work with publish.",
	"main": "src/main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^26.6.4",
		"@typescript-eslint/eslint-plugin": "8.71.1",
		"@typescript-eslint/parser": "8.71.1",
		"esbuild": "^0.28.2",
		"obsidian": "latest",
		"tslib": "2.8.1",
		"typescript": "~5.9",
		"vitest": "^5.0.3"
	}
}
